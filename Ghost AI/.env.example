# Ghost AI - Environment Variables
# Copy this to .env and fill in your keys

# ============ LLM SETTINGS ============
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# OR use Gemini instead
GEMINI_API_KEY=your_gemini_api_key_here

# ============ STT SETTINGS ============
# "local" = Whisper via OpenAI API (cheapest + easiest)
# "openai" = OpenAI Whisper cloud
# "deepgram" = Deepgram cloud
STT_PROVIDER=openai
DEEPGRAM_API_KEY=your_deepgram_key_here

# ============ AUDIO SETTINGS ============
AUDIO_CHUNK_MS=500
AUDIO_SAMPLE_RATE=16000

# ============ ENGINE SETTINGS ============
ENGINE_PORT=3001
LLM_DEBOUNCE_MS=3000
CONTEXT_BUFFER_SIZE=50

# ============ OVERLAY SETTINGS ============
OVERLAY_POSITION=bottom-right
OVERLAY_OPACITY=0.92

# ============ MODES ============
# interview | meeting | coding | general
DEFAULT_MODE=interview
