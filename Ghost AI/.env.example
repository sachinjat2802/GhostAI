# Ghost AI - Environment Variables
# Copy this to .env and fill in your keys

# ============ LLM SETTINGS (GEMINI) ============
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ============ STT SETTINGS ============
# "gemini" = Gemini Flash Audio STT
# "openai" = OpenAI Whisper cloud
# "mock" = Built-in offline testing mock
STT_PROVIDER=gemini

# ============ AUDIO SETTINGS ============
AUDIO_CHUNK_MS=500
AUDIO_SAMPLE_RATE=16000

# ============ ENGINE SETTINGS ============
ENGINE_PORT=3001
LLM_DEBOUNCE_MS=500
CONTEXT_BUFFER_SIZE=50

# ============ OVERLAY SETTINGS ============
OVERLAY_POSITION=bottom-right
OVERLAY_OPACITY=0.92
DEFAULT_MODE=interview
